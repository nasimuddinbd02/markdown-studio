{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Studio",
  "version": "0.12.0",
  "identifier": "com.markdownstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Markdown Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown editor",
    "longDescription": "Markdown Studio is a fast, privacy-conscious, local-first Markdown editor with live preview, tabs and workspace navigation.",
    "copyright": "Copyright © Markdown Studio contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "publisher": "Markdown Studio",
    "homepage": "https://github.com/nasimuddin-dev/markdown-studio",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2Q0NDNkE4QTA1MDc4ODcKUldTSGVGQ2dxTWJNWnJzNlFmUksxTk16blBHREloUXhmWFgySThyM2Q1eGhpMWxhYzN2NldsbTMK",
      "endpoints": [
        "https://github.com/nasimuddin-dev/markdown-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
